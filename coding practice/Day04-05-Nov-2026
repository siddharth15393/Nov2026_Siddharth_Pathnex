🔹 Ansible — Install and Configure Nginx
- name: Install and configure Nginx
  hosts: all
  become: yes
  tasks:
    - name: Install nginx
      yum:
        name: nginx
        state: present
    - name: Configure nginx
      template:
        src: nginx.conf.j2
        dest: /etc/nginx/nginx.conf
    - name: Start nginx service
      service:
        name: nginx
        state: started
        enabled: yes


#=======================================================
			Day04 Ansible
#=======================================================
- name: Install and Configure Nginx
  hosts: all
  become: yes
  tasks:
     - name: Install Nginx
       yum:
          name: nginx
	  state: present
     - name: configure Nginx
       template: 
       	   src: nginx.conf.j2
	   dest: /etc/nginx/nginx.conf
     - name: Start Nginx Service
       service:
          name: nginx
	  state: started
	  enabled: yes

